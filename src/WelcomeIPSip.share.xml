									<Enumeration Text="Außenstation" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<!-- Reihenfolge = Wis::ClientTypeChoice -->
							<ParameterType Id="%AID%_PT-WISClientType" Name="WISClientType">
								<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
									<Enumeration Text="free@home next" Value="0" Id="%ENID%" />
