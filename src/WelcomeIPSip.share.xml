								<Parameter Id="%AID%_UP-%TT%00009" Name="WISClientName" ParameterType="%AID%_PT-Text40Byte" Offset="0" BitOffset="0" Text="Client-Name (im Portal)" Value="OpenKNX-WelcomeIPSip" />
							</Union>
							<!-- Offsets 252.. bleiben frei (Reserve für spätere Parameter). -->
